{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "9router-cf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "9router-db",
      "database_id": "e93c720e-e291-4714-b033-a120a5506112"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "DATA_DIR": "/tmp"
  },
  "placement": {
    "region": "gcp:us-central1"
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  }
}

